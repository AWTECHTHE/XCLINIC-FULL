# Variáveis usadas pelo docker-compose.yml na raiz do monorepo.
# Copie para .env e ajuste os valores antes de rodar `docker compose up`.
# As credenciais reais do backend continuam em xclinic-server-backend/config/dev.env

POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db
DATABASE_URL=postgresql://your_user:your_password@xclinic_postgres:5432/your_db

# URL que o app híbrido (Next.js) usa para chamar a API. Aponte para o Nginx (porta 90)
# ou diretamente para a API (porta 8000) conforme seu cenário local.
NEXT_PUBLIC_API_URL=http://localhost:90
