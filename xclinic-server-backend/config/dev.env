POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db
# NOTE: DATABASE_URL aqui usa o hostname "postgres_db" (nome do serviço no
# xclinic-server-backend/docker-compose.yml standalone/legado). No
# docker-compose.yml unificado da raiz do monorepo, o Postgres é o serviço
# "db"/"xclinic_postgres" - lá, essa variável é sobrescrita pelo DATABASE_URL
# do .env raiz (a variável `environment:` do compose tem prioridade sobre
# `env_file:`), então este valor só é realmente usado ao rodar o
# docker-compose.yml standalone (legado, dentro deste diretório).
DATABASE_URL=postgresql://your_user:your_password@postgres_db:5432/your_db
ALLOWED_HOSTS=localhost,127.0.0.1,xclinic_api,api,xclinic_nginx,awlicite_api,awlicite-api,postgres_db,yourdomain.com
MAX_FORM_BODY_SIZE=1048576
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRATION=60
JWT_REFRESH_EXPIRATION=1
