DATABASE_URL='postgres://your_user:your_password@postgres_db:5432/your_db'
POSTGRES_USER='your_user'
POSTGRES_PASSWORD='your_password'
POSTGRES_DB='your_db'
JWT_SECRET='your_jwt_secret'
JWT_EXPIRATION='3600'
JWT_REFRESH_SECRET='your_refresh_jwt_secret'
JWT_REFRESH_EXPIRATION='86400'

# Opcional: extração de dados de bioimpedância via Docling + LLM
# (POST /inbody/). Sem essas duas configuradas, o upload continua
# funcionando, mas a extração fica "unavailable" (nenhum dado inventado).
# LLM_PROVIDER='openai'
# LLM_API_KEY='your_llm_api_key'
# DOCLING_API_KEY='your_docling_api_key'